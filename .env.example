# Copy to .env and fill in. Never commit .env.
# Used by docker compose and by apps/api (which also reads apps/api/.env).

# --- API ---
ENVIRONMENT=development
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=pathify_db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Public URL of the web app. Used for CORS, CSRF origin checks and OAuth redirects.
WEB_ORIGIN=http://localhost:3000

# --- AI (Ksarth). Leave empty to use the offline stub provider. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Or Pathify's own distilled model behind llama.cpp / vLLM / Ollama (see apps/ml/README.md):
# LLM_PROVIDER=local
# LOCAL_LLM_URL=http://localhost:8080/v1

# --- Pathify's ML models (optional) ---
# Hugging Face repo with the exported encoders; the Docker build downloads them.
PATHIFY_MODELS_REPO=

# --- Email (verification and password reset). Empty: emails go to the API log. ---
RESEND_API_KEY=
EMAIL_FROM=Pathify <onboarding@resend.dev>

# --- Payments (Razorpay, test mode keys start with rzp_test_). Empty: plans can't be bought. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Social sign-in (optional) ---
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Web ---
# Where the Next.js server proxies /api/* requests.
API_INTERNAL_URL=http://localhost:8000
