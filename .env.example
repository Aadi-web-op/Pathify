# Copy to .env and fill in. Never commit .env.
# Used by docker compose and by apps/api (which also reads apps/api/.env).

# --- API ---
ENVIRONMENT=development
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=pathify_db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Public URL of the web app. Used for CORS, CSRF origin checks and OAuth redirects.
WEB_ORIGIN=http://localhost:3000

# --- AI (Ksarth). Leave empty to use the offline stub provider. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Social sign-in (optional) ---
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Web ---
# Where the Next.js server proxies /api/* requests.
API_INTERNAL_URL=http://localhost:8000
