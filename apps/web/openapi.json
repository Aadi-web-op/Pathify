{
  "components": {
    "schemas": {
      "Board": {
        "enum": [
          "cbse",
          "icse",
          "state",
          "ib",
          "other"
        ],
        "title": "Board",
        "type": "string"
      },
      "DeleteAccount": {
        "properties": {
          "email": {
            "description": "Type the account email to confirm.",
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "DeleteAccount",
        "type": "object"
      },
      "Goal": {
        "enum": [
          "choose_stream",
          "choose_exams_degree",
          "first_job",
          "switch_field",
          "explore"
        ],
        "title": "Goal",
        "type": "string"
      },
      "GoogleIn": {
        "properties": {
          "credential": {
            "description": "ID token from Google Identity Services",
            "minLength": 10,
            "title": "Credential",
            "type": "string"
          }
        },
        "required": [
          "credential"
        ],
        "title": "GoogleIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "llm_provider": {
            "title": "Llm Provider",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "llm_provider"
        ],
        "title": "Health",
        "type": "object"
      },
      "KsarthMessageIn": {
        "properties": {
          "content": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "KsarthMessageIn",
        "type": "object"
      },
      "KsarthMessageOut": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "KsarthMessageOut",
        "type": "object"
      },
      "KsarthStatus": {
        "properties": {
          "messages_per_hour": {
            "title": "Messages Per Hour",
            "type": "integer"
          },
          "offline": {
            "description": "True when replies come from the offline stub, not a real model.",
            "title": "Offline",
            "type": "boolean"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "offline",
          "messages_per_hour"
        ],
        "title": "KsarthStatus",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "Preferences": {
        "properties": {
          "theme": {
            "default": "system",
            "enum": [
              "light",
              "dark",
              "system"
            ],
            "title": "Theme",
            "type": "string"
          }
        },
        "title": "Preferences",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "certificates_earned": {
            "default": 0,
            "title": "Certificates Earned",
            "type": "integer"
          },
          "completed_courses": {
            "default": 0,
            "title": "Completed Courses",
            "type": "integer"
          },
          "level": {
            "default": 1,
            "title": "Level",
            "type": "integer"
          },
          "streak_days": {
            "default": 0,
            "title": "Streak Days",
            "type": "integer"
          },
          "xp": {
            "default": 0,
            "title": "Xp",
            "type": "integer"
          }
        },
        "title": "Progress",
        "type": "object"
      },
      "ProvidersOut": {
        "properties": {
          "github": {
            "title": "Github",
            "type": "boolean"
          },
          "google_client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Google Client Id"
          },
          "linkedin": {
            "title": "Linkedin",
            "type": "boolean"
          }
        },
        "required": [
          "google_client_id",
          "github",
          "linkedin"
        ],
        "title": "ProvidersOut",
        "type": "object"
      },
      "RegisterIn": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "RegisterIn",
        "type": "object"
      },
      "Stage": {
        "enum": [
          "school_9_10",
          "school_11_12",
          "college",
          "graduate"
        ],
        "title": "Stage",
        "type": "string"
      },
      "Stream": {
        "enum": [
          "science_pcm",
          "science_pcb",
          "science_pcmb",
          "commerce",
          "humanities",
          "vocational",
          "undecided"
        ],
        "title": "Stream",
        "type": "string"
      },
      "StudentProfile": {
        "description": "What onboarding collects. Each stage needs different details.",
        "properties": {
          "board": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Board"
              },
              {
                "type": "null"
              }
            ]
          },
          "degree": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "College students and graduates",
            "title": "Degree"
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/Goal"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Goals",
            "type": "array"
          },
          "grade": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Class 9 to 12, school students only",
            "title": "Grade"
          },
          "guardian_aware": {
            "default": false,
            "description": "School students confirm a parent or guardian knows they use Pathify.",
            "title": "Guardian Aware",
            "type": "boolean"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Interests",
            "type": "array"
          },
          "language": {
            "default": "en",
            "enum": [
              "en",
              "hi"
            ],
            "title": "Language",
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Indian state or union territory",
            "title": "State"
          },
          "stream": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stream"
              },
              {
                "type": "null"
              }
            ],
            "description": "Class 11 and 12 only"
          },
          "year_of_study": {
            "anyOf": [
              {
                "maximum": 6.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Of Study"
          }
        },
        "required": [
          "stage",
          "goals"
        ],
        "title": "StudentProfile",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "auth_providers": {
            "items": {
              "type": "string"
            },
            "title": "Auth Providers",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "has_password": {
            "title": "Has Password",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "onboarded": {
            "title": "Onboarded",
            "type": "boolean"
          },
          "preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StudentProfile"
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "auth_providers",
          "has_password",
          "profile",
          "onboarded",
          "preferences",
          "progress",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "theme": {
            "anyOf": [
              {
                "enum": [
                  "light",
                  "dark",
                  "system"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Career guidance for students from Class 9 to college.",
    "title": "Pathify API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/google": {
      "post": {
        "operationId": "google_api_auth_google_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Google",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
